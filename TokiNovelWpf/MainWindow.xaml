<Window x:Class="TokiNovelWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Toki Novel Downloader" 
        Height="860" Width="680"
        MinHeight="780" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Malgun Gothic, Segoe UI">

    <Window.Resources>
        <!-- 모던 다크 컬러 팔레트 -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0F19"/>
        <SolidColorBrush x:Key="CardBg" Color="#151C2E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A344D"/>
        <SolidColorBrush x:Key="InputBg" Color="#0D1322"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#A855F7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#A855F7" Offset="0.5"/>
            <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>

        <!-- 버튼 스타일 -->
        <Style x:Key="GradientButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252F48"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 텍스트박스 스타일 -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 커스텀 프로그레스바 스타일 -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#090D17"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="PART_Indicator" Background="{StaticResource ProgressGradient}" CornerRadius="6" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- URL Input -->
            <RowDefinition Height="Auto"/> <!-- Novel Info Card -->
            <RowDefinition Height="Auto"/> <!-- Options Card -->
            <RowDefinition Height="Auto"/> <!-- Progress Card -->
            <RowDefinition Height="*"/>    <!-- Console Log & Action Button -->
        </Grid.RowDefinitions>

        <!-- 1. 헤더 -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📚" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Toki Novel Downloader" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="프리미엄 웹소설 데스크톱 다운로더" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>
            
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#142B24" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                    <TextBlock Text="준비 완료" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. URL 입력 카드 -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="🔗 소설 목록 화면 URL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtUrl" Style="{StaticResource ModernTextBoxStyle}" Text="https://newtoki1.org/novel/63587" Grid.Column="0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnInspect" Style="{StaticResource SecondaryButtonStyle}" Content="🔍 소설 정보 조회" Grid.Column="1" Click="BtnInspect_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. 소설 정보 카드 (분석 시 노출) -->
        <Border x:Name="PnlNovelInfo" Grid.Row="2" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="LblNovelTitle" Text="EX급 흡혈헌터는 살고 싶다" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="LblNovelAuthor" Text="✍️ 작가: 아이스망고" FontSize="13" Foreground="#CBD5E1" Margin="0,0,14,0"/>
                    <TextBlock x:Name="LblNovelGenre" Text="🏷️ 장르: 판타지" FontSize="13" Foreground="#CBD5E1" Margin="0,0,14,0"/>
                    <TextBlock x:Name="LblNovelCount" Text="총 100화" FontSize="13" Foreground="#CBD5E1" Margin="0,0,14,0"/>
                    <Border x:Name="BadgeStatus" Background="#059669" CornerRadius="6" Padding="6,2">
                        <TextBlock x:Name="LblNovelStatus" Text="연재중" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 4. 다운로드 설정 카드 -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="⚙️ 다운로드 범위 및 저장 설정" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                
                <RadioButton x:Name="RdoAll" Content="전체 다운로드 (1화 ~ 끝까지)" IsChecked="True" Foreground="White" Margin="0,0,0,8" Checked="RdoRange_CheckedChanged" Unchecked="RdoRange_CheckedChanged"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RdoRange" Content="일부 범위 지정" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" Checked="RdoRange_CheckedChanged" Unchecked="RdoRange_CheckedChanged"/>
                    <TextBox x:Name="TxtStart" Style="{StaticResource ModernTextBoxStyle}" Text="1" Width="55" IsEnabled="False" TextAlignment="Center"/>
                    <TextBlock Text="화 ~ " Foreground="White" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBox x:Name="TxtLast" Style="{StaticResource ModernTextBoxStyle}" Text="10" Width="55" IsEnabled="False" TextAlignment="Center"/>
                    <TextBlock Text="화" Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📁 저장 폴더: " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtOutputDir" Style="{StaticResource ModernTextBoxStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                    <Button x:Name="BtnBrowse" Style="{StaticResource SecondaryButtonStyle}" Content="📁 폴더 선택" Grid.Column="2" Click="BtnBrowse_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. 실시간 진행 카드 -->
        <Border Grid.Row="4" Background="#161B30" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="LblProgressText" Text="진행 상태: 대기 중 (0%)" FontSize="13" FontWeight="Bold" Foreground="#A855F7"/>
                    <TextBlock x:Name="LblPercent" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#EC4899" HorizontalAlignment="Right"/>
                </Grid>
                
                <ProgressBar x:Name="ProgBar" Style="{StaticResource ModernProgressBarStyle}" Value="0" Margin="0,0,0,8"/>
                
                <TextBlock x:Name="LblCurrentTask" Text="준비 완료. [다운로드 시작]을 눌러주세요." FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- 6. 콘솔 로그 & 액션 버튼 -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#060913" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtConsoleLog" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" 
                             FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" TextWrapping="Wrap" 
                             Text="[시스템] Toki Novel Downloader GUI 준비 완료."/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1">
                <Button x:Name="BtnStart" Style="{StaticResource GradientButtonStyle}" Content="▶ 다운로드 시작" Height="46" FontSize="15" Click="BtnStart_Click"/>
                <Button x:Name="BtnStop" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="15" Content="⏹ 다운로드 중단" Height="46" Cursor="Hand" Visibility="Collapsed" Click="BtnStop_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
