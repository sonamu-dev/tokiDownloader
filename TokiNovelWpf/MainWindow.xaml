<Window x:Class="TokiNovelWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Toki Novel Downloader" 
        Height="960" Width="740"
        MinHeight="850" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Malgun Gothic, Segoe UI">

    <Window.Resources>
        <!-- 모던 다크 컬러 팔레트 -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0F19"/>
        <SolidColorBrush x:Key="CardBg" Color="#151C2E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A344D"/>
        <SolidColorBrush x:Key="InputBg" Color="#0D1322"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#A855F7" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#A855F7" Offset="0.5"/>
            <GradientStop Color="#EC4899" Offset="1"/>
        </LinearGradientBrush>

        <!-- 버튼 스타일 -->
        <Style x:Key="GradientButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252F48"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 텍스트박스 스타일 -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 커스텀 프로그레스바 스타일 -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#090D17"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="PART_Indicator" Background="{StaticResource ProgressGradient}" CornerRadius="6" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- URL Input & Add Queue -->
            <RowDefinition Height="Auto"/> <!-- Novel Info Card -->
            <RowDefinition Height="Auto"/> <!-- Options Card -->
            <RowDefinition Height="Auto"/> <!-- Queue List Card -->
            <RowDefinition Height="Auto"/> <!-- Progress Card -->
            <RowDefinition Height="Auto"/> <!-- Power Auto Shutdown Card -->
            <RowDefinition Height="*"/>    <!-- Console Log & Action Button -->
        </Grid.RowDefinitions>

        <!-- 1. 헤더 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📚" FontSize="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Toki Novel Downloader" FontSize="19" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="순차 대기열 다운로드 &amp; 완료 후 자동 전원 종료 탑재" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>
            
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#142B24" BorderBrush="#059669" BorderThickness="1" CornerRadius="12" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                    <TextBlock x:Name="LblGlobalStatus" Text="준비 완료" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. URL 입력 & 대기열 추가 카드 -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🔗 소설 목록 화면 URL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtUrl" Style="{StaticResource ModernTextBoxStyle}" Text="https://newtoki1.org/novel/63587" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button x:Name="BtnInspect" Style="{StaticResource SecondaryButtonStyle}" Content="🔍 소설 정보 조회" Grid.Column="1" Margin="0,0,6,0" Click="BtnInspect_Click"/>
                    <Button x:Name="BtnAddToQueue" Style="{StaticResource SecondaryButtonStyle}" Background="#4F46E5" Content="➕ 대기열에 추가" Grid.Column="2" Click="BtnAddToQueue_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. 소설 정보 카드 (분석 시 노출) -->
        <Border x:Name="PnlNovelInfo" Grid.Row="2" Background="#161B30" BorderBrush="#2D3759" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="LblNovelTitle" Text="소설 제목" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LblNovelAuthor" Text="✍️ 작가: -" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <TextBlock Text=" • " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBlock x:Name="LblNovelGenre" Text="🏷️ 장르: -" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    <TextBlock Text=" • " FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBlock x:Name="LblNovelCount" Text="총 0화" FontSize="13" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border x:Name="BadgeStatus" Background="#059669" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="LblNovelStatus" Text="완결" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 4. 다운로드 범위 및 저장 폴더 카드 -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="⚙️ 다운로드 범위 및 저장 폴더" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="RdoAll" Content="전체 다운로드" IsChecked="True" Foreground="White" Margin="0,0,16,0" Checked="RdoRange_CheckedChanged" Unchecked="RdoRange_CheckedChanged"/>
                    <RadioButton x:Name="RdoRange" Content="일부 범위:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Checked="RdoRange_CheckedChanged" Unchecked="RdoRange_CheckedChanged"/>
                    <TextBox x:Name="TxtStart" Style="{StaticResource ModernTextBoxStyle}" Text="1" Width="85" Padding="4,6" TextAlignment="Center" GotFocus="TxtRange_GotFocus" PreviewMouseLeftButtonDown="TxtRange_PreviewMouseLeftButtonDown" TextChanged="TxtRange_TextChanged"/>
                    <TextBlock Text="화 ~ " Foreground="White" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBox x:Name="TxtLast" Style="{StaticResource ModernTextBoxStyle}" Text="10" Width="85" Padding="4,6" TextAlignment="Center" GotFocus="TxtRange_GotFocus" PreviewMouseLeftButtonDown="TxtRange_PreviewMouseLeftButtonDown" TextChanged="TxtRange_TextChanged"/>
                    <TextBlock Text="화" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📁 저장 폴더: " Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtOutputDir" Style="{StaticResource ModernTextBoxStyle}" Grid.Column="1" Margin="0,0,8,0"/>
                    <Button x:Name="BtnBrowse" Style="{StaticResource SecondaryButtonStyle}" Content="📁 폴더 선택" Grid.Column="2" Click="BtnBrowse_Click"/>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <CheckBox x:Name="ChkHeadless" Content="👻 브라우저 창 숨기기 (백그라운드에서 조용히 다운로드, 다른 웹 서핑 가능)" IsChecked="True" Foreground="#A5B4FC" FontSize="11.5" VerticalAlignment="Center" ToolTip="Chrome 창을 띄우지 않고 백그라운드에서 실행합니다. 본인의 평소 웹 서핑(Chrome/Edge 등)과 완전히 독립되어 실행됩니다."/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. 순차 다운로드 대기열 카드 -->
        <Border Grid.Row="4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="📋 다운로드 대기열 (순서대로 수집)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnRemoveSelected" Style="{StaticResource SecondaryButtonStyle}" Content="🗑️ 선택 삭제" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="BtnRemoveSelected_Click"/>
                        <Button x:Name="BtnClearQueue" Style="{StaticResource SecondaryButtonStyle}" Content="🧹 전체 비우기" Padding="8,3" FontSize="11" Click="BtnClearQueue_Click"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="LstQueue" Height="105" Background="#090D18" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" 
                         Foreground="White" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E293B"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#141B2D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding IndexStr}" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="12" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}"/>
                                <TextBlock Text="{Binding RangeStr}" Foreground="#94A3B8" FontSize="11.5" Grid.Column="2" Margin="6,0,10,0" VerticalAlignment="Center"/>
                                
                                <!-- 책 제목과 화 수 뒤로부터 끝까지 프로그래스바 영역 -->
                                <Grid Grid.Column="3" Height="20" VerticalAlignment="Center" Margin="0,0,4,0">
                                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Height="20" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Background="#1E293B"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 6. 실시간 진행 상황 카드 -->
        <Border Grid.Row="5" Background="#161B30" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="LblProgressText" Text="대기 중 (0%)" FontSize="12.5" FontWeight="Bold" Foreground="#A855F7"/>
                    <TextBlock x:Name="LblPercent" Text="0%" FontSize="12.5" FontWeight="Bold" Foreground="#EC4899" HorizontalAlignment="Right"/>
                </Grid>
                
                <ProgressBar x:Name="ProgBar" Style="{StaticResource ModernProgressBarStyle}" Value="0" Margin="0,0,0,6"/>
                
                <TextBlock x:Name="LblCurrentTask" Text="준비 완료. [대기열 다운로드 시작]을 눌러주세요." FontSize="11.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- 7. ⚡ 자동 전원 종료 전용 강조 카드 -->
        <Border Grid.Row="6" Background="#261A05" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="ChkAutoShutdown" Content="모든 다운로드 완료 시 컴퓨터 끄기 (자동 전원 종료)" 
                              Foreground="#FDE047" FontWeight="Bold" FontSize="13.5" Cursor="Hand"/>
                    <TextBlock Text="💡 화면 잠금(Win+L)이나 모니터가 꺼진 상태에서도 작업 완료 후 60초 뒤 안전하게 전원이 꺼집니다." 
                               FontSize="11" Foreground="#FBBF24" Margin="24,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 8. 콘솔 로그 & 액션 버튼 -->
        <Grid Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#060913" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtConsoleLog" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" 
                             FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" 
                             Text="[시스템] Toki Novel Downloader 순차 대기열 및 자동 종료 시스템 준비 완료."/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1">
                <Button x:Name="BtnStart" Style="{StaticResource GradientButtonStyle}" Content="▶ 대기열 다운로드 시작" Height="46" FontSize="15" Click="BtnStart_Click"/>
                <Button x:Name="BtnStop" Background="#DC2626" Foreground="White" FontWeight="Bold" FontSize="15" Content="⏹ 전체 작업 중단" Height="46" Cursor="Hand" Visibility="Collapsed" Click="BtnStop_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
